+// StoreUsageAttribution logs usage attribution per model.
+// It satisfies the supervisor's Phase 2 request for model-switching token tracking.
+func (s *Store) StoreUsageAttribution(sessionID, model string, tokens, durationMs int) error {
+	if s.sqliteDB != nil {
+		_, err := s.sqliteDB.db.Exec(`INSERT INTO model_usage (session_id, model, tokens_used, duration_ms, created_at) VALUES (?, ?, ?, ?, CURRENT_TIMESTAMP)`,
